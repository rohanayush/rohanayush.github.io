---
import Layout from '../../layouts/Layout.astro';
import { products } from '../../data/products';
import NoteArt from '../../components/NoteArt.astro';
import EyeArt from '../../components/EyeArt.astro';
import { profile } from '../../data/profile';

const base = import.meta.env.BASE_URL;
const link = (p: (typeof products)[number]) =>
  p.href === '/' ? base : `${base}products/${p.slug}/`;

// The smallest file on offer — "from 1.3 MB" on the card footer.
const smallest = (p: (typeof products)[number]) => {
  const sizes = p.downloads.map((d) => parseFloat(d.size ?? '')).filter((n) => !Number.isNaN(n));
  return sizes.length ? `${Math.min(...sizes).toFixed(1)} MB` : null;
};
---

<Layout
  title={`Products — ${profile.name}`}
  description="Apps for Windows and Android: on my mind, Calculate what you do!, Sthir and Eye Rest Reminder. Free downloads, no accounts."
>
  <section class="catalogue">
    <div class="container">
      <span class="eyebrow" data-reveal>Everything built so far</span>
      <h1 class="page-title" data-reveal="mask">Products.</h1>
      <p class="page-lead" data-reveal>
        Every one of these started as a problem I actually had — sore eyes, hours I
        couldn't account for, a note that kept getting buried. Applications with some
        soul in them, not another dashboard. Nothing here needs an account, nothing
        phones home, and every download is free.
      </p>

      <div class="cat-grid" data-reveal-group="up">
        {products.map((p) => (
          <a class={`cat-card t-${p.tint}`} href={link(p)}>
            {p.art === 'note' ? (
              <span class="cat-shot cat-shot-art"><NoteArt /></span>
            ) : p.art === 'eye' ? (
              <span class="cat-shot cat-shot-art"><EyeArt /></span>
            ) : p.shots?.length ? (
              <span class={`cat-shot shape-${p.shotShape ?? 'wide'}`}>
                <img
                  src={`${base}${p.thumb ?? p.shots[0].src}`}
                  alt={p.shots[0].alt}
                  loading="lazy"
                  decoding="async"
                />
              </span>
            ) : (
              <span class="cat-shot cat-shot-empty" aria-hidden="true">
                <span class="cat-shot-emoji">{p.emoji}</span>
              </span>
            )}
            <span class="cat-eyebrow">{p.eyebrow}</span>
            <h2 class="cat-name">{p.name}</h2>
            {p.subtitle && <span class="cat-subtitle">{p.subtitle}</span>}
            <p class="cat-copy">{p.card}</p>
            <span class="cat-stack">
              {p.stack.map((tech) => <i>{tech}</i>)}
            </span>
            <span class="cat-foot">
              {p.slug === 'on-my-mind'
                ? 'The flagship'
                : `${p.downloads.length} download${p.downloads.length === 1 ? '' : 's'}`}
              {smallest(p) && <em class="cat-size">from {smallest(p)}</em>}
              <i>→</i>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-title { font-size: clamp(2.2rem, 6vw, 3.6rem); font-weight: 800; letter-spacing: -0.03em; margin: 0.5rem 0 0.8rem; }
  .page-lead { color: var(--muted); max-width: 52ch; font-size: 1.08rem; margin: 0 0 3rem; }

  .cat-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem; }
  .cat-card {
    position: relative; overflow: hidden;
    display: flex; flex-direction: column; gap: 0.5rem;
    padding: 1.8rem; border-radius: 20px;
    background: var(--bg-soft); border: 1px solid var(--line);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .cat-card::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(420px 200px at 100% 0%, var(--tint-glow), transparent 65%);
  }
  .cat-card:hover { transform: translateY(-5px); border-color: var(--tint-line); box-shadow: 0 26px 60px -34px rgba(0,0,0,0.95); }
  .t-yellow { --tint-glow: rgba(255,225,107,0.16); --tint-line: rgba(255,225,107,0.45); --tint: var(--note-yellow); }
  .t-pink   { --tint-glow: rgba(255,143,177,0.16); --tint-line: rgba(255,143,177,0.45); --tint: var(--note-pink); }
  .t-mint   { --tint-glow: rgba(143,240,197,0.16); --tint-line: rgba(143,240,197,0.45); --tint: var(--note-mint); }
  .t-blue   { --tint-glow: rgba(143,184,255,0.16); --tint-line: rgba(143,184,255,0.45); --tint: var(--note-blue); }

  /* Screenshot preview at the top of each card. */
  .cat-shot {
    display: block; height: 190px; margin: -0.4rem 0 1rem; border-radius: 14px;
    overflow: hidden; border: 1px solid var(--line); background: rgba(0,0,0,0.35);
    position: relative; z-index: 1;
  }
  /* The frame is wide and short, so every capture fills it from the top —
     a whole phone screen letterboxed in here would be a sliver. */
  .cat-shot img {
    display: block; width: 100%; height: 100%;
    object-fit: cover; object-position: top center;
  }
  .cat-shot.shape-wide img { object-position: top left; }
  /* CSS-drawn thumbnail fills the frame edge to edge. */
  .cat-shot-art { padding: 0; background: none; }
  .cat-shot-empty {
    display: grid; place-items: center;
    background:
      radial-gradient(300px 140px at 50% 20%, var(--tint-glow), transparent 70%),
      rgba(255,255,255,0.02);
  }
  .cat-shot-emoji { font-size: 2.8rem; opacity: 0.45; }
  .cat-card:hover .cat-shot img { transform: scale(1.03); }
  .cat-shot img { transition: transform 0.35s ease; }

  .cat-emoji { font-size: 1.9rem; }
  .cat-eyebrow {
    text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.7rem;
    font-weight: 700; color: var(--tint);
  }
  .cat-name { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; }
  .cat-subtitle { color: var(--tint); font-size: 0.85rem; font-weight: 600; opacity: 0.9; margin-top: -0.15rem; }
  .cat-copy { color: var(--muted); line-height: 1.55; margin: 0; flex: 1; font-size: 0.95rem; }
  /* what it's built with */
  .cat-stack { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.9rem; }
  .cat-stack i {
    font-style: normal; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.02em;
    color: var(--tint); padding: 0.22rem 0.5rem; border-radius: 7px;
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 0 1px var(--tint-line);
  }
  .cat-foot {
    display: inline-flex; align-items: center; gap: 0.45rem; margin-top: 0.8rem;
    font-size: 0.85rem; font-weight: 700; color: var(--ink);
  }
  .cat-size {
    font-style: normal; font-weight: 600; font-size: 0.78rem; color: var(--muted);
    padding-left: 0.55rem; margin-left: 0.1rem; border-left: 1px solid var(--line);
  }
  .cat-foot i { font-style: normal; color: var(--tint); transition: transform 0.2s ease; }
  .cat-card:hover .cat-foot i { transform: translateX(4px); }

  @media (max-width: 820px) {
    .cat-grid { grid-template-columns: 1fr; }
  }
</style>
