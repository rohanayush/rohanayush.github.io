---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';

const base = import.meta.env.BASE_URL;

const channels = [
  {
    kind: 'Email',
    tint: 'yellow',
    icon: '✉',
    label: profile.email,
    href: `mailto:${profile.email}`,
    note: 'The surest way to reach me. I read everything and reply to anything real.',
    primary: true,
  },
  {
    kind: 'LinkedIn',
    tint: 'blue',
    icon: 'in',
    label: profile.linkedin.label,
    href: profile.linkedin.url,
    note: 'Roles, referrals and the full work history — connect or message me there.',
    external: true,
  },
  {
    kind: 'GitHub',
    tint: 'mint',
    icon: '{ }',
    label: profile.github.label,
    href: profile.github.url,
    note: 'Source for the apps on this site, and whatever I am tinkering with next.',
    external: true,
  },
];
---

<Layout
  title={`Contact — ${profile.name}`}
  description={`Get in touch with ${profile.name}, ${profile.role} based in ${profile.location}. Open to remote roles.`}
>
  <section class="contact-hero">
    <div class="container">
      <span class="eyebrow" data-reveal>Contact</span>
      <h1 class="page-title" data-reveal="mask">Let's talk.</h1>
      <p class="page-lead" data-reveal>
        Hiring for a senior frontend role, want to ask about something on this site,
        or just found one of the apps useful — either way, say hello.
      </p>
    </div>
  </section>

  <section class="channels">
    <div class="container">
      <div class="ch-grid" data-reveal-group="up">
        {channels.map((c) => (
          <a
            class:list={[`ch-card t-${c.tint}`, { primary: c.primary }]}
            href={c.href}
            target={c.external ? '_blank' : undefined}
            rel={c.external ? 'noopener' : undefined}
          >
            <span class="ch-icon">{c.icon}</span>
            <span class="ch-kind">{c.kind}</span>
            <strong class="ch-label">{c.label}</strong>
            <span class="ch-note">{c.note}</span>
            <span class="ch-go">{c.external ? 'Open ↗' : 'Send an email →'}</span>
          </a>
        ))}
      </div>

      <div class="where" data-reveal="scale">
        <div class="where-item">
          <span>Based in</span>
          <strong>{profile.location}</strong>
        </div>
        <div class="where-item">
          <span>Open to</span>
          <strong>Remote roles</strong>
        </div>
        <div class="where-item">
          <span>Currently</span>
          <strong>{profile.experience[0].role} at Hughes Systique</strong>
        </div>
      </div>

      <p class="tail" data-reveal>
        Curious what I build outside work? The <a href={`${base}products/`}>products</a> are all free,
        and there's more about my background on the <a href={`${base}about/`}>about page</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .contact-hero { padding-bottom: 1.5rem; }
  .page-title { font-size: clamp(2.4rem, 7vw, 4rem); font-weight: 800; letter-spacing: -0.03em; margin: 0.5rem 0 0.9rem; }
  .page-lead { color: var(--muted); max-width: 52ch; font-size: 1.1rem; line-height: 1.6; margin: 0; }

  .channels { padding-top: 1.5rem; }
  .ch-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem; }
  .ch-card {
    position: relative; overflow: hidden;
    display: flex; flex-direction: column; gap: 0.35rem; padding: 1.7rem;
    background: var(--bg-soft); border: 1px solid var(--line); border-radius: 20px;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .ch-card::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(360px 170px at 100% 0%, var(--tint-glow), transparent 65%);
  }
  .ch-card:hover { transform: translateY(-5px); border-color: var(--tint-line); box-shadow: 0 26px 60px -34px rgba(0,0,0,0.95); }
  .ch-card.primary { border-color: rgba(255,214,77,0.45); box-shadow: 0 0 0 1px rgba(255,214,77,0.12); }
  .t-yellow { --tint: var(--note-yellow); --tint-glow: rgba(255,225,107,0.16); --tint-line: rgba(255,225,107,0.5); }
  .t-blue   { --tint: var(--note-blue);   --tint-glow: rgba(143,184,255,0.16); --tint-line: rgba(143,184,255,0.5); }
  .t-mint   { --tint: var(--note-mint);   --tint-glow: rgba(143,240,197,0.16); --tint-line: rgba(143,240,197,0.5); }

  .ch-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.6rem; height: 2.6rem; border-radius: 12px; margin-bottom: 0.6rem;
    background: rgba(255,255,255,0.05); border: 1px solid var(--line);
    color: var(--tint); font-weight: 800; font-size: 1.05rem;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
  }
  .ch-kind { text-transform: uppercase; letter-spacing: 0.15em; font-size: 0.68rem; font-weight: 700; color: var(--tint); }
  .ch-label { font-size: 1.02rem; font-weight: 700; word-break: break-word; }
  .ch-note { color: var(--muted); font-size: 0.9rem; line-height: 1.55; flex: 1; margin-top: 0.3rem; }
  .ch-go { margin-top: 1rem; font-size: 0.85rem; font-weight: 700; color: var(--tint); }

  .where {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;
    margin-top: 2.4rem; padding: 1.5rem; border-radius: 18px;
    background: rgba(255,255,255,0.02); border: 1px solid var(--line);
  }
  .where-item { display: grid; gap: 0.2rem; }
  .where-item span { color: var(--muted); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.13em; font-weight: 700; }
  .where-item strong { font-size: 0.98rem; font-weight: 700; }

  .tail { color: var(--muted); font-size: 0.95rem; margin: 2rem 0 0; line-height: 1.6; }
  .tail a { color: var(--accent); font-weight: 600; }
  .tail a:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .ch-grid, .where { grid-template-columns: 1fr; }
  }
</style>
