---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';

const base = import.meta.env.BASE_URL;

// Each panel gets its own note colour, cycling down the page.
const tints = ['yellow', 'pink', 'mint', 'blue'] as const;
---

<Layout
  title={`About — ${profile.name}`}
  description={`${profile.role} with 6+ years in Angular, Vue.js and TypeScript. Enterprise frontend at Hughes Systique and Infosys, plus apps built on the side.`}
>
  <!-- ===== INTRO ===== -->
  <section class="intro">
    <div class="container intro-grid">
      <div>
        <span class="eyebrow" data-reveal>About</span>
        <h1 class="page-title" data-reveal="mask">{profile.name}</h1>
        <p class="role" data-reveal>
          {profile.role}
          <span class="role-stack">{profile.stack.join('  ·  ')}</span>
        </p>
        {profile.summary.map((para) => <p class="summary" data-reveal>{para}</p>)}
        <div class="intro-cta" data-reveal>
          <a class="btn btn-primary" href={`${base}contact/`}>Get in touch</a>
          <a class="btn btn-ghost" href={`${base}products/`}>See what I've built</a>
        </div>
      </div>

      <aside class="facts" data-reveal="right">
        <ul>
          <li><span>Based in</span><strong>{profile.location}</strong></li>
          <li><span>Experience</span><strong>6+ years</strong></li>
          <li><span>Primary</span><strong>Angular</strong></li>
          <li><span>Also</span><strong>Vue.js · TypeScript</strong></li>
          <li><span>Open to</span><strong>Remote roles</strong></li>
        </ul>
        <p class="facts-note">{profile.lookingFor}</p>
      </aside>
    </div>
  </section>

  <!-- ===== SKILLS ===== -->
  <section class="skills">
    <div class="container">
      <span class="eyebrow" data-reveal>What I work with</span>
      <h2 class="section-title" data-reveal="mask">Technical skills.</h2>
      <div class="skill-grid" data-reveal-group="up">
        {profile.skills.map((group, i) => (
          <article class={`skill-card t-${group.tint}`}>
            <div class="skill-inner">
              <span class="skill-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="skill-title">{group.title}</h3>
              <ul class="skill-tags">
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== HOW I WORK ===== -->
  <section class="how">
    <div class="container">
      <span class="eyebrow" data-reveal>What I'm like to work with</span>
      <h2 class="section-title" data-reveal="mask">How I work.</h2>
      <p class="how-lead" data-reveal>
        Everything below is tied to something on this site, so you can check it
        rather than take my word for it.
      </p>

      <!-- The one thing to read if you read nothing else. -->
      <blockquote class="ethos" data-reveal="scale">
        <span class="ethos-mark" aria-hidden="true">❝</span>
        <h3 class="ethos-title">{profile.ethos.title}</h3>
        <p class="ethos-text">{profile.ethos.text}</p>
      </blockquote>

      <div class="how-grid" data-reveal-group="up">
        {profile.howIWork.map((item, i) => (
          <article class={`how-card t-${tints[i % tints.length]}`}>
            <span class="how-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="how-title">{item.title}</h3>
            <p class="how-text">{item.text}</p>
          </article>
        ))}
      </div>

      <p class="how-tail" data-reveal>{profile.beyondWork}</p>
    </div>
  </section>

  <!-- ===== EXPERIENCE ===== -->
  <section class="experience">
    <div class="container">
      <span class="eyebrow" data-reveal>Where I've worked</span>
      <h2 class="section-title" data-reveal="mask">Experience.</h2>
      <ol class="timeline" data-reveal-group="left">
        {profile.experience.map((job, i) => (
          <li
            class:list={[
              `job t-${tints[i % tints.length]}`,
              { current: job.current, aside: job.aside },
            ]}
          >
            <span class="rail-node" aria-hidden="true"></span>
            <div class="job-panel">
              <span class="job-no" aria-hidden="true">{String(profile.experience.length - i).padStart(2, '0')}</span>
              <div class="job-head">
                <h3 class="job-role">
                  {job.role}
                  {job.current && <span class="badge">Now</span>}
                  {job.aside && <span class="badge badge-quiet">Break</span>}
                </h3>
                <p class="job-company">{job.company} <span class="sep">·</span> {job.place}</p>
                <p class="job-period">
                  <span class="chip">{job.period}</span>
                  <span class="len">{job.length}</span>
                </p>
              </div>
              <ul class="job-points">
                {job.points.map((p) => <li>{p}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===== EDUCATION ===== -->
  <section class="education">
    <div class="container">
      <span class="eyebrow" data-reveal>Background</span>
      <h2 class="section-title" data-reveal="mask">Education &amp; certifications.</h2>
      <div class="edu-grid" data-reveal-group="up">
        {profile.education.map((e) => (
          <article class="edu-card">
            <span class="edu-kind">Degree</span>
            <h3>{e.title}</h3>
            <p>{e.org}</p>
            <p class="edu-meta">{e.period} · {e.detail}</p>
          </article>
        ))}
        {profile.certifications.map((c) => (
          <article class="edu-card">
            <span class="edu-kind">Certification</span>
            <h3>{c.title}</h3>
            <p>{c.org}</p>
            <p class="edu-meta">{c.period}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="about-cta">
    <div class="container cta-box" data-reveal="scale">
      <h2 class="section-title">Looking for a senior frontend engineer?</h2>
      <p>{profile.lookingFor}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={`mailto:${profile.email}`}>✉ {profile.email}</a>
        <a class="btn btn-ghost" href={profile.linkedin.url} target="_blank" rel="noopener">LinkedIn ↗</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-title { font-size: clamp(2.2rem, 6vw, 3.6rem); font-weight: 800; letter-spacing: -0.03em; margin: 0.5rem 0 0.5rem; }
  .section-title { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 800; letter-spacing: -0.02em; margin-top: 0.4rem; }

  /* ---- Intro ---- */
  .intro { padding-bottom: 3rem; }
  .intro-grid { display: grid; grid-template-columns: 1.4fr 0.6fr; gap: 3rem; align-items: start; }
  .role { color: var(--accent); font-weight: 700; font-size: 1.05rem; margin: 0 0 1.6rem; }
  .role-stack { display: block; color: var(--muted); font-weight: 600; font-size: 0.92rem; margin-top: 0.3rem; }
  .summary { color: var(--ink); font-size: 1.08rem; line-height: 1.7; margin: 0 0 1.2rem; }
  .intro-cta { display: flex; gap: 0.8rem; margin-top: 1.8rem; flex-wrap: wrap; }

  .facts {
    background: var(--bg-soft); border: 1px solid var(--line); border-radius: 18px; padding: 1.5rem;
  }
  .facts ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.9rem; }
  .facts li { display: grid; gap: 0.15rem; font-size: 0.92rem; }
  .facts span { color: var(--muted); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.12em; font-weight: 700; }
  .facts strong { font-weight: 700; }
  .facts-note {
    color: var(--muted); font-size: 0.88rem; line-height: 1.55;
    margin: 1.3rem 0 0; padding-top: 1.1rem; border-top: 1px solid var(--line);
  }

  /* ---- Shared tints + the angular "panel" cut ---- */
  .t-yellow { --tint: var(--note-yellow); --tint-soft: rgba(255,225,107,0.16); --tint-line: rgba(255,225,107,0.5); }
  .t-mint   { --tint: var(--note-mint);   --tint-soft: rgba(143,240,197,0.16); --tint-line: rgba(143,240,197,0.5); }
  .t-blue   { --tint: var(--note-blue);   --tint-soft: rgba(143,184,255,0.16); --tint-line: rgba(143,184,255,0.5); }
  .t-pink   { --tint: var(--note-pink);   --tint-soft: rgba(255,143,177,0.16); --tint-line: rgba(255,143,177,0.5); }

  /* Notch the top-right and bottom-left corners — the manga panel shape. */
  .skill-card, .skill-inner, .job-panel, .job-panel::before {
    clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 20px 100%, 0 calc(100% - 20px));
  }

  /* ---- Skills ---- */
  .skill-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 0.4rem; }
  .skill-card {
    position: relative; padding: 2px;
    background: linear-gradient(150deg, var(--tint) 0%, var(--tint-line) 22%, var(--line) 60%);
    transition: transform 0.22s cubic-bezier(0.34, 1.4, 0.64, 1), filter 0.22s ease;
  }
  .skill-card:hover { transform: translateY(-6px) rotate(-0.6deg); filter: drop-shadow(0 18px 26px rgba(0,0,0,0.55)); }
  .skill-inner {
    position: relative; overflow: hidden; height: 100%; padding: 1.5rem 1.4rem;
    background:
      radial-gradient(280px 130px at 100% 0%, var(--tint-soft), transparent 70%),
      var(--bg-soft);
  }
  /* diagonal speed lines, faint until you hover */
  .skill-inner::after {
    content: ''; position: absolute; inset: -20%; pointer-events: none;
    background: repeating-linear-gradient(115deg, transparent 0 9px, rgba(255,255,255,0.045) 9px 10px);
    opacity: 0.5; transform: translateX(-12%); transition: opacity 0.25s ease, transform 0.5s ease;
  }
  .skill-card:hover .skill-inner::after { opacity: 1; transform: translateX(0); }
  .skill-no {
    position: absolute; top: -0.55rem; right: 0.5rem; font-size: 4.2rem; font-weight: 900;
    font-style: italic; letter-spacing: -0.05em; color: transparent;
    -webkit-text-stroke: 2px var(--tint); opacity: 0.22; pointer-events: none; line-height: 1;
  }
  /* Slanted ribbon behind the label, with the text left upright. */
  .skill-title {
    position: relative; display: inline-block; font-size: 0.76rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.16em; color: #14121a;
    padding: 0.32rem 0.75rem; margin-bottom: 1rem; z-index: 1;
  }
  .skill-title::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: var(--tint); transform: skewX(-12deg);
    box-shadow: 0 6px 14px -8px var(--tint);
  }
  .skill-tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; position: relative; }
  .skill-tags li {
    font-size: 0.82rem; font-weight: 700; padding: 0.32rem 0.65rem;
    background: rgba(255,255,255,0.05); border: 1px solid var(--line);
    clip-path: polygon(0 0, calc(100% - 7px) 0, 100% 7px, 100% 100%, 7px 100%, 0 calc(100% - 7px));
    transition: transform 0.16s ease, background 0.16s ease, color 0.16s ease;
  }
  .skill-tags li:hover { transform: translateY(-2px) rotate(-1.5deg); background: var(--tint); color: #14121a; }

  /* ---- How I work ---- */
  .how-lead { color: var(--muted); max-width: 56ch; font-size: 1.05rem; line-height: 1.6; margin: 0.9rem 0 2rem; }

  /* The manifesto panel — the loudest thing in the section. */
  .ethos {
    position: relative; overflow: hidden; margin: 0 0 1.6rem;
    padding: clamp(1.6rem, 3.5vw, 2.4rem) clamp(1.5rem, 3vw, 2.6rem);
    background:
      radial-gradient(680px 260px at 100% 0%, rgba(255, 225, 107, 0.14), transparent 62%),
      radial-gradient(520px 240px at 0% 100%, rgba(255, 143, 177, 0.12), transparent 62%),
      var(--bg-soft);
    box-shadow: inset 0 0 0 1px var(--line), inset 5px 0 0 0 var(--accent);
    clip-path: polygon(0 0, calc(100% - 26px) 0, 100% 26px, 100% 100%, 26px 100%, 0 calc(100% - 26px));
  }
  .ethos::after {
    content: ''; position: absolute; inset: -30%; pointer-events: none;
    background: repeating-linear-gradient(112deg, transparent 0 13px, rgba(255,255,255,0.035) 13px 14px);
  }
  .ethos-mark {
    position: absolute; top: 0.1rem; right: 1.1rem; font-size: 5.5rem; line-height: 1;
    color: var(--accent); opacity: 0.16; pointer-events: none;
  }
  .ethos-title {
    position: relative; font-size: clamp(1.25rem, 2.6vw, 1.75rem); font-weight: 800;
    letter-spacing: -0.02em; margin-bottom: 0.9rem; padding-right: 3rem;
  }
  .ethos-text {
    position: relative; color: var(--ink); font-size: 1.04rem; line-height: 1.72;
    margin: 0; max-width: 76ch; opacity: 0.94;
  }
  .how-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem; }
  .how-card {
    position: relative; overflow: hidden; padding: 1.6rem 1.5rem;
    background:
      radial-gradient(360px 170px at 100% 0%, var(--tint-soft), transparent 68%),
      var(--bg-soft);
    box-shadow: inset 0 0 0 1px var(--line), inset 0 -3px 0 0 var(--tint);
    clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 18px 100%, 0 calc(100% - 18px));
    transition: transform 0.24s cubic-bezier(0.34, 1.35, 0.64, 1), box-shadow 0.24s ease;
  }
  .how-card:hover {
    transform: translateY(-5px);
    box-shadow: inset 0 0 0 1px var(--tint-line), inset 0 -4px 0 0 var(--tint), 0 22px 44px -30px #000;
  }
  .how-no {
    position: absolute; top: -0.4rem; right: 0.7rem; font-size: 3.6rem; font-weight: 900;
    font-style: italic; letter-spacing: -0.06em; line-height: 1; color: transparent;
    -webkit-text-stroke: 2px var(--tint); opacity: 0.18; pointer-events: none;
  }
  .how-title {
    position: relative; font-size: 1.02rem; font-weight: 800; line-height: 1.35;
    margin-bottom: 0.7rem; padding-right: 2.4rem;
  }
  .how-text { position: relative; color: var(--muted); font-size: 0.92rem; line-height: 1.62; margin: 0; }
  .how-tail {
    color: var(--ink); font-size: 1.02rem; line-height: 1.7; margin: 2.2rem 0 0;
    max-width: 68ch; padding-left: 1.1rem; border-left: 3px solid var(--accent);
  }

  /* ---- Experience: one panel per role, hung off a rail ---- */
  .timeline { list-style: none; padding: 0; margin: 1.4rem 0 0; position: relative; }
  .timeline::before {
    content: ''; position: absolute; left: 9px; top: 0; bottom: 0; width: 2px;
    background: linear-gradient(180deg, var(--accent), rgba(255,143,177,0.5) 40%, rgba(143,184,255,0.35) 75%, transparent);
    opacity: 0.5;
  }
  .job { position: relative; padding: 0 0 1.6rem 3rem; }
  .job:last-child { padding-bottom: 0; }
  .rail-node {
    position: absolute; left: 1px; top: 2rem; width: 18px; height: 18px;
    background: var(--tint); transform: rotate(45deg);
    box-shadow: 0 0 0 4px var(--bg), 0 0 16px -2px var(--tint);
    transition: transform 0.25s cubic-bezier(0.34, 1.5, 0.64, 1);
  }
  .job:hover .rail-node { transform: rotate(135deg) scale(1.15); }
  /* A break in the run of jobs — hollow node instead of a filled one. */
  .job.aside .rail-node {
    background: var(--bg-soft); box-shadow: inset 0 0 0 2px var(--tint), 0 0 0 4px var(--bg);
  }

  .job-panel {
    position: relative; overflow: hidden; padding: 1.6rem 1.7rem;
    background:
      radial-gradient(520px 200px at 100% 0%, var(--tint-soft), transparent 65%),
      linear-gradient(180deg, rgba(255,255,255,0.03), transparent 40%),
      var(--bg-soft);
    box-shadow: inset 0 0 0 1px var(--line), inset 4px 0 0 0 var(--tint);
    transition: transform 0.24s cubic-bezier(0.34, 1.35, 0.64, 1), box-shadow 0.24s ease;
  }
  .job-panel::after {
    content: ''; position: absolute; inset: -30%; pointer-events: none;
    background: repeating-linear-gradient(112deg, transparent 0 11px, rgba(255,255,255,0.04) 11px 12px);
    opacity: 0; transform: translateX(-8%); transition: opacity 0.3s ease, transform 0.6s ease;
  }
  .job:hover .job-panel { transform: translateX(6px); box-shadow: inset 0 0 0 1px var(--tint-line), inset 6px 0 0 0 var(--tint), 0 22px 44px -30px #000; }
  .job:hover .job-panel::after { opacity: 1; transform: translateX(0); }
  .job.current .job-panel { box-shadow: inset 0 0 0 1px var(--tint-line), inset 5px 0 0 0 var(--tint), 0 0 34px -22px var(--tint); }

  .job-no {
    position: absolute; top: 0.2rem; right: 0.9rem; font-size: 4.6rem; font-weight: 900;
    font-style: italic; letter-spacing: -0.06em; line-height: 1; color: transparent;
    -webkit-text-stroke: 2px var(--tint); opacity: 0.2; pointer-events: none;
  }

  .job-role {
    position: relative; font-size: 1.24rem; font-weight: 800; letter-spacing: -0.01em;
    display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;
  }
  .badge {
    background: var(--tint); color: #14121a; font-size: 0.6rem; font-weight: 900;
    text-transform: uppercase; letter-spacing: 0.12em; padding: 0.22rem 0.55rem;
    transform: skewX(-12deg); display: inline-block;
  }
  .badge-quiet { background: transparent; color: var(--tint); box-shadow: inset 0 0 0 1px var(--tint-line); }
  .job-company { position: relative; color: var(--ink); font-size: 0.96rem; margin: 0.45rem 0 0.6rem; font-weight: 700; }
  .job-company .sep { color: var(--tint); }
  .job-period { position: relative; display: flex; align-items: center; gap: 0.6rem; margin: 0; flex-wrap: wrap; }
  .chip {
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace; font-size: 0.78rem; font-weight: 700;
    color: var(--tint); background: rgba(255,255,255,0.04); padding: 0.22rem 0.55rem;
    box-shadow: inset 0 0 0 1px var(--tint-line);
    clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 6px 100%, 0 calc(100% - 6px));
  }
  .len { color: var(--muted); font-size: 0.8rem; }

  .job-points { position: relative; list-style: none; padding: 0; margin: 1.1rem 0 0; display: grid; gap: 0.6rem; }
  .job-points li { position: relative; padding-left: 1.5rem; color: var(--muted); font-size: 0.95rem; line-height: 1.6; }
  .job-points li::before {
    content: '▸'; position: absolute; left: 0; top: -0.02em;
    color: var(--tint); font-size: 0.9rem; opacity: 0.9;
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-card, .job-panel, .rail-node, .skill-tags li,
    .skill-inner::after, .job-panel::after { transition: none; }
    .skill-card:hover, .job:hover .job-panel { transform: none; }
  }

  /* ---- Education ---- */
  .edu-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 0.4rem; }
  .edu-card {
    background: var(--bg-soft); border: 1px solid var(--line); border-radius: 16px; padding: 1.4rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .edu-card:hover { border-color: rgba(255,214,77,0.4); transform: translateY(-3px); }
  .edu-kind {
    font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.14em;
    font-weight: 700; color: var(--accent);
  }
  .edu-card h3 { font-size: 1.02rem; font-weight: 700; margin: 0.6rem 0 0.45rem; line-height: 1.35; }
  .edu-card p { color: var(--muted); font-size: 0.9rem; margin: 0; }
  .edu-meta { margin-top: 0.4rem !important; font-size: 0.82rem !important; opacity: 0.85; }

  /* ---- CTA ---- */
  .about-cta { padding-top: 0; }
  .cta-box {
    border-radius: 24px; padding: clamp(1.8rem, 4vw, 3rem);
    background:
      radial-gradient(700px 300px at 100% 0%, rgba(255,225,107,0.14), transparent 60%),
      radial-gradient(600px 300px at 0% 100%, rgba(143,184,255,0.14), transparent 60%),
      var(--bg-soft);
    border: 1px solid var(--line);
  }
  .cta-box p { color: var(--muted); max-width: 52ch; margin: 0.9rem 0 0; font-size: 1.02rem; line-height: 1.6; }
  .cta-row { display: flex; gap: 0.8rem; margin-top: 1.8rem; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .intro-grid { grid-template-columns: 1fr; gap: 2rem; }
    .skill-grid, .how-grid { grid-template-columns: repeat(2, 1fr); }
    .edu-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .skill-grid, .how-grid { grid-template-columns: 1fr; }
  }
</style>
