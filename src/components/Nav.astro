---
// Top navigation. About & Contact are disabled placeholders for when this
// site grows into a full portfolio.
//
// The first link is whichever product you last opened. It starts as the
// flagship, becomes the app you pick, and stays on that app — including on
// the All products page, which the URL alone can't tell us. The choice is
// remembered for the session only, so a fresh visit starts at on my mind.
import { products } from '../data/products';
import { profile } from '../data/profile';

const { pathname } = Astro.url;
const base = import.meta.env.BASE_URL;
const isActive = (href: string) => pathname === href || pathname === href + '/';

const hrefFor = (p: (typeof products)[number]) =>
  p.href === '/' ? base : `${base}products/${p.slug}/`;

const onCatalogue = isActive(`${base}products/`);
const flagship = products.find((p) => p.slug === 'on-my-mind')!;
// The product whose own page we're on, if any — home counts as the flagship's.
const selected = isActive(base)
  ? flagship
  : products.find((p) => isActive(`${base}products/${p.slug}/`));

const current = selected ?? flagship;
const currentActive = Boolean(selected);

// Handed to the inline script so it can swap the label without a fetch.
const navProducts = products.map((p) => ({ slug: p.slug, name: p.name, href: hrefFor(p) }));
---

<header class="nav">
  <div class="container nav-inner">
    <a href={base} class="brand">
      <span class="brand-dot"></span>
      <span class="brand-text">
        <strong>{profile.name.replace(' Singh', '')}</strong>
        <em>products first</em>
      </span>
    </a>

    <nav class="nav-links">
      <a
        id="nav-current"
        href={hrefFor(current)}
        class:list={["nav-link", { active: currentActive }]}
      >{current.name}</a>
      <a href={`${base}products/`} class:list={["nav-link", { active: onCatalogue }]}>
        All products
      </a>
      <a href={`${base}about/`} class:list={["nav-link", { active: isActive(`${base}about/`) }]}>
        About
      </a>
      <a href={`${base}contact/`} class:list={["nav-link", { active: isActive(`${base}contact/`) }]}>
        Contact
      </a>
    </nav>
  </div>
</header>

<script is:inline define:vars={{ navProducts, selectedSlug: selected?.slug ?? null }}>
  // Landing on a product's own page records it; every other page just shows
  // whatever was recorded last. sessionStorage, so it resets on a fresh visit.
  (function () {
    const KEY = 'omm:last-product';
    try {
      if (selectedSlug) {
        sessionStorage.setItem(KEY, selectedSlug);
        return;
      }
      const saved = sessionStorage.getItem(KEY);
      if (!saved) return;
      const hit = navProducts.find((p) => p.slug === saved);
      const link = document.getElementById('nav-current');
      if (hit && link) {
        link.textContent = hit.name;
        link.href = hit.href;
      }
    } catch (e) {
      // Storage blocked (private mode / cookies off) — the default label stands.
    }
  })();
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(12px);
    background: rgba(14, 13, 19, 0.7);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .brand-text { display: grid; gap: 0.05rem; line-height: 1.1; }
  .brand-text strong {
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: 1.05rem;
  }
  /* the hint: what this site leads with */
  .brand-text em {
    font-style: normal;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent);
    opacity: 0.75;
  }
  .brand:hover .brand-text em { opacity: 1; }
  .brand-dot {
    width: 12px; height: 12px; border-radius: 4px;
    background: var(--note-yellow);
    box-shadow: 0 0 0 4px rgba(255, 225, 107, 0.18);
    transform: rotate(-8deg);
  }
  .nav-links { display: flex; align-items: center; gap: 0.4rem; }
  .nav-link {
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--muted);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav-link:not(.disabled):hover { color: var(--ink); background: rgba(255,255,255,0.05); }
  .nav-link.active { color: #1a1606; background: var(--accent); }
  .nav-link.disabled {
    color: rgba(154, 147, 168, 0.5);
    cursor: not-allowed;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .nav-link.disabled em {
    font-style: normal;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.1rem 0.35rem;
    border-radius: 6px;
    background: rgba(255,255,255,0.06);
  }
  @media (max-width: 560px) {
    .brand-text em { display: none; }
  }
</style>
