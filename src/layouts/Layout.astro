---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { profile } from '../data/profile';

const base = import.meta.env.BASE_URL;

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'on my mind — the note app that actually sticks, for Windows',
  description = 'on my mind keeps fully dynamic markdown notes visible above every app. Pinning, images, themes and more. Free download.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
    <!-- Arm the reveal styles before first paint. Without JS this never runs,
         and every [data-reveal] element simply stays visible. -->
    <script is:inline>document.documentElement.classList.add('reveal-ready');</script>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-who">
          <strong>{profile.name}</strong>
          <span>{profile.role} · {profile.location}</span>
        </div>
        <nav class="footer-links">
          <a href={base}>on my mind</a>
          <a href={`${base}products/`}>Products</a>
          <a href={`${base}about/`}>About</a>
          <a href={`${base}contact/`}>Contact</a>
          <a href={profile.github.url} target="_blank" rel="noopener">GitHub ↗</a>
          <a href={profile.linkedin.url} target="_blank" rel="noopener">LinkedIn ↗</a>
        </nav>
      </div>
      <div class="container footer-fine">
        <span>© {new Date().getFullYear()} {profile.name} — built with Astro.</span>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </div>
    </footer>

    <script is:inline>
      // Scroll reveal. [data-reveal-group="<variant>"] expands to its children,
      // each delayed a beat after the last, so grids deal themselves in.
      (function () {
        var STEP = 90;

        document.querySelectorAll('[data-reveal-group]').forEach(function (group) {
          var variant = group.getAttribute('data-reveal-group') || 'up';
          Array.prototype.forEach.call(group.children, function (child, i) {
            if (!child.hasAttribute('data-reveal')) child.setAttribute('data-reveal', variant);
            child.style.setProperty('--reveal-delay', i * STEP + 'ms');
          });
        });

        var targets = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) {
          targets.forEach(function (el) { el.classList.add('is-in'); });
          return;
        }

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target); // reveal once, then leave it alone
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );

        targets.forEach(function (el) { io.observe(el); });
      })();
    </script>

    <style>
      .site-footer {
        border-top: 1px solid var(--line);
        padding: 2rem 0;
        color: var(--muted);
        font-size: 0.88rem;
      }
      .footer-inner {
        display: flex; justify-content: space-between; gap: 1.6rem; flex-wrap: wrap;
        align-items: flex-start;
      }
      .footer-who { display: grid; gap: 0.25rem; }
      .footer-who strong { color: var(--ink); font-size: 1rem; font-weight: 700; }
      .footer-links { display: flex; gap: 1.1rem; flex-wrap: wrap; }
      .footer-links a { transition: color 0.15s ease; }
      .footer-links a:hover { color: var(--accent); }
      .footer-fine {
        display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
        margin-top: 1.6rem; padding-top: 1.2rem; border-top: 1px solid var(--line);
        font-size: 0.82rem; opacity: 0.8;
      }
      .footer-fine a:hover { color: var(--accent); }
    </style>
  </body>
</html>
