---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'on my mind — the note app that actually sticks, for Windows & macOS',
  description = 'on my mind keeps fully dynamic markdown notes visible above every app. Pinning, images, themes and more. Free download.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} on my mind — crafted with Astro.</span>
        <span class="footer-soon">About &amp; Contact arriving with the portfolio.</span>
      </div>
    </footer>

    <style>
      .site-footer {
        border-top: 1px solid var(--line);
        padding: 2rem 0;
        color: var(--muted);
        font-size: 0.88rem;
      }
      .footer-inner { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
      .footer-soon { opacity: 0.7; }
    </style>
  </body>
</html>
